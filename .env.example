# Copy this file to ".env" (same folder) and fill in your NEW keys.
# ".env" is listed in .gitignore, so it will never be pushed to GitHub.

# Archive RPC endpoints used by `cast run` to replay old transactions.
# Alchemy free tier includes archive data. Create one app for Ethereum
# and one for BNB Smart Chain and paste the HTTPS URLs here.
ETH_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/PASTE_NEW_KEY
BSC_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/PASTE_NEW_KEY

# LLM key (used from Step 5 onwards). Create a NEW one; the old one is public.
GROQ_API_KEY=PASTE_NEW_GROQ_KEY

# Optional. If set, cast shows verified contract names (e.g. "EToken")
# instead of bare addresses. Free key from etherscan.io (works for BSC too).
ETHERSCAN_API_KEY=

# Optional. Only needed if you installed Foundry from the zip instead of
# foundryup, e.g. CAST_BIN=C:/foundry/cast.exe
CAST_BIN=
